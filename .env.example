# Template only. Replace with real values in a local ignored .env file.
# Never commit real credentials.

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Backend
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/droplink

# Object storage — provider-specific values to be selected after the stack decision.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Application policy
TRANSFER_TTL_MINUTES=30
MAX_TRANSFER_BYTES=52428800
MAX_FILES_PER_TRANSFER=10
MAX_FILE_BYTES=52428800

# Generate a strong random value locally if the chosen design needs an application secret.
# Do not use this placeholder in any environment.
APP_SECRET=replace-me
