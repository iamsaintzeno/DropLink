# Template only. Replace with real values in a local ignored .env file.
# Never commit real credentials.

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Backend — general
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Backend — Supabase (all backend-only; never prefix with VITE_)
SUPABASE_URL=https://your-project-ref.supabase.co
DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=droplink-files

# Application policy
TRANSFER_TTL_MINUTES=30
MAX_TRANSFER_BYTES=52428800
MAX_FILES_PER_TRANSFER=10
MAX_FILE_BYTES=52428800

# Generate a strong random value locally if the chosen design needs an application secret.
# Do not use this placeholder in any environment.
APP_SECRET=replace-me
